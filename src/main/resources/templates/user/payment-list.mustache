{{> layout/header}}

<div class="container p-5">
    <div class="card">
        <div class="card-header">
            <h4><b>결제 내역</b></h4>
        </div>
        <div class="card-body">
            <!-- 결제 항목 카드 -->

                <div class="card mb-4">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start">
                            <div class="flex-grow-1">
                                <h5 class="card-title mb-2">결제 #</h5>
                                <!-- font-awesome이랑 연결되어있다(header 확인) 그래서 fa-형태로 이모티콘 사용 가능 -->
                                <p class="text-muted mb-2"><i class="fa-solid fa-receipt"></i> 주문번호 : </p>
                                <p class="text-muted mb-2"><i class="fa-solid fa-key"></i> 결제번호 : </p>
                                <p class="text-muted mb-2"><i class="fa-solid fa-calendar"></i> 결제일 :</p>
                                <p class="text-muted mb-2"><i class="fa-solid fa-circle-info"></i> 상태 :</p>
                            </div>
                            <div class="text-end">
                                <span class="badge bg-primary fs-6">+ P</span>
                            </div>
                        </div>
                    </div>
                </div>

            <!-- 결제 내역이 없을 때 -->

                <div class="text-center py-5">
                    <i class="fa-solid fa-cart-shopping fa-5x text-muted mb-3"></i>
                    <h5 class="text-muted">결제 내역이 없습니다.</h5>
                    <p class="text-muted">포인트를 충전해 유료 게시글을 구매해 보세요!</p>
                    <a href="/" class="btn btn-primary">게시글 목록으로</a>
                    <a href="/user/point/charge" class="btn btn-success">포인트 충전하기</a>
                </div>

            <div class="mb-4">
                <a href="/user/detail" class="btn btn-secondary">마이페이지로 돌아가기</a>
            </div>
        </div>
    </div>
</div>

{{> layout/footer}}