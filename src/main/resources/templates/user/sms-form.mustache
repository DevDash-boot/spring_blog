{{> layout/header}}

<div class="container p-5">
    <div class="card">
        <div class="card-header"><b>휴대폰 인증</b></div>
        <div class="card-body">
            <form action="/sms" method="post">
                <div class="input-group mb-3">
                    <input type="text" class="form-control" placeholder="전화번호(01012345678처럼 '-' 없이 입력)" name="telNumber" id="telNumber">
                    <button type="button" class="btn btn-outline-secondary" id="send-btn" onclick="sendCode()">
                        인증 번호 전송
                    </button>
                </div>
                <div class="input-group mb-3">
                    <input type="text" class="form-control" id="code" placeholder="인증 번호 입력" maxlength="10">
                    <button type="button" class="btn btn-outline-secondary" onclick="verifyCode()">인증 번호 확인</button>
                </div>
                <div id="msg" class="form-text mb-3"></div>
                <button type="button" class="btn btn-primary form-control mt-3" onclick="location.href='/user/detail'">
                    마이페이지로 돌아가기
                </button>
            </form>
        </div>
    </div>
</div>

<script>
    // 인증 완료 여부
    let isSmsVerified = false;
    // 1. 인증 번호 전송
    async function sendCode() {
        const telNumber = document.querySelector("#telNumber").value;   // 사용자 입력: a@naver.com
        if (!telNumber) {
            alert("전화번호를 입력해주세요.");
            return;
        }
        // 메일 발송에 시간이 걸리므로, 그동안 버튼을 막아 중복 요청을 방지한다.
        const sendBtn = document.querySelector("#send-btn");
        sendBtn.disabled = true;
        sendBtn.innerText = "전송 중...";

        try {
            const response = await fetch("/api/sms/send", {
                method: "POST",
                headers: {"Content-Type": "application/json"}, // 바디가 json이라고 알림
                body: JSON.stringify({telNumber: telNumber})    // 객체에서 json 문자열로 변환
            });
            const result = await response.json(); // json 응답을 자바스크립트 객체로 변환됨
            // 백엔드 개발자와 어떤 식으로 요청을 보내고 어떤 식으로 응답이 올지 확인해야 한다.
            // 백엔드 API에서 key : message로 내려 보내기로 했다
            alert(result.message);
            if (response.ok) {
                let sendTime  = 60;
                sendBtn.disabled = true;
                sendBtn.innerText = `재전송 대기시간 (${sendTime}초)`;
                const smsTimer = setInterval(()=>{
                    sendTime--;
                    if(sendTime <=0){
                        clearInterval(smsTimer)
                        sendBtn.disabled = false;
                        sendBtn.innerText = "인증 번호 재전송";
                        return;
                    }
                    sendBtn.innerText = `재전송 대기시간 (${sendTime}초)`;
                }, 1000);
            } else{
                sendBtn.disabled = false;
                sendBtn.innerText = "인증 번호 전송";
            }
        } catch (e) {
            console.log(e);
            alert("서버와 통신하지 못했습니다.");
        }
    }

    // 2. 인증 번호 확인. 전송
    async function verifyCode() {
        // 사용자 이메일, 인증 코드(6자리)
        const telNumber = document.querySelector("#telNumber").value;
        const code = document.querySelector("#code").value;

        if (!code) {
            alert("인증 번호를 입력해 주세요.");
            return;
        }
        try {
            const response = await fetch("/api/sms/verify", {
                method: "POST",
                headers: {"Content-Type": "application/json"},
                body: JSON.stringify({telNumber: telNumber, code: code})    // 객체에서 json으로 변환
            })
            const result = await response.json();   // json에서 객체로 변환
            const msgBox = document.querySelector("#msg");
            if (response.ok) {
                isSmsVerified = true;
                msgBox.innerText = result.message;  // 인증되었습니다.
                msgBox.className = "form-text text-success";
                // 인증한 이메일을 화면에서 바꾸지 못하게 잠금 설정
                document.querySelector("#telNumber").readOnly = true;
                document.querySelector("#send-btn").disabled = true;
            } else {
                msgBox.innerText = result.message;
                msgBox.className = "form-text text-danger";
            }
        } catch (e) {
            alert("서버와 통신하지 못했습니다.");
        }
    }

    // 3. 회원 가입 제출 직전 확인(false를 반환하면 제출이 취소됨)
    function checkVerify() {
        if (!isSmsVerified) {
            alert("휴대폰 인증을 먼저 완료해주세요.");
            return false;
        }
        return true;
    }

</script>
{{> layout/footer}}