nale-scene .play-status{min-height:0}.mag-kitchen{max-width:1000px!important;display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:56px;align-items:center;font-family:'Trebuchet MS',Arial,sans-serif}.mag-fridge{position:relative;background:#f7f6f2;border:3px solid #c9c6bd;border-radius:18px;padding:26px 70px 26px 24px;min-height:400px;display:flex;flex-direction:column;box-shadow:inset -14px 0 0 #ebe9e3}.mag-letters{display:flex;flex-wrap:wrap;gap:14px 16px}.mag-l{--dx:0px;--dy:0px;width:58px;height:62px;padding:0!important;border:0!important;border-radius:10px!important;font:900 38px/1 'Arial Black',Arial,sans-serif!important;color:#fff!important;transform:translate(var(--dx),var(--dy)) rotate(var(--r,0deg));transition:transform .15s ease-out;box-shadow:0 3px 0 #0003}.mag-l:focus-visible{outline:3px solid #1f2a2e;outline-offset:3px}.ml1{background:#d6452f!important;--r:-6deg}.ml2{background:#2f7d8c!important;--r:4deg}.ml3{background:#c98a1c!important;--r:-3deg}.ml4{background:#3d8b4f!important;--r:7deg}.ml5{background:#1f2a2e!important;--r:-8deg}.ml6{background:#d6452f!important;--r:3deg}.ml7{background:#2f7d8c!important;--r:-4deg}.ml8{background:#c98a1c!important;--r:6deg}.ml9{background:#3d8b4f!important;--r:-2deg}.ml10{background:#1f2a2e!important;--r:5deg}.mag-strip{margin:auto 0 0;border-top:2px dashed #c9c6bd;padding-top:16px;font:700 13px 'Trebuchet MS',Arial,sans-serif;color:#5b6467}.mag-strip span{display:block;font:900 40px/1.1 'Arial Black',Arial,sans-serif;letter-spacing:.06em;color:#1f2a2e;min-height:46px;overflow-wrap:anywhere}.mag-handle{position:absolute;right:14px;top:36px;bottom:36px;display:flex;align-items:center}.mag-handle .nf-home{writing-mode:vertical-rl;background:#1f2a2e;color:#f7f6f2;border-radius:10px;padding:18px 10px;font:700 13px 'Trebuchet MS',Arial,sans-serif;text-decoration:none}.mag-done .mag-handle .nf-home{background:#d6452f}.mag-copy .nf-title{font:700 clamp(32px,4.4vw,54px)/1.05 'Trebuchet MS',Arial,sans-serif;letter-spacing:-1px;margin:0 0 16px}.mag-copy .nf-message{font:17px/1.6 'Trebuchet MS',Arial,sans-serif;margin:0 0 22px}.mag-actions{display:flex;flex-wrap:wrap;gap:10px}.mag-actions button{background:none;color:#1f2a2e;border:2px solid #1f2a2e}.mag-copy .play-status{font-size:15px}@media(prefers-reduced-motion:reduce){.mag-l{transition:none}}@media(max-width:760px){.mag-kitchen{grid-template-columns:1fr;gap:30px}.mag-fridge{min-height:0;padding-right:58px}.mag-l{width:46px;height:50px;font-size:30px!important}.mag-strip span{font-size:30px}}.nf-title,.nf-message{overflow-wrap:anywhere}
