<main class="nf-page interactive-scene finale-scene fin-magnets" data-experience="fin-magnets">
    <div class="nf-content mag-kitchen">
        <div class="mag-fridge" data-fridge="">
            <div class="mag-letters" role="group" aria-label="Fridge letters">
                <button type="button" class="mag-l ml1" data-letter="4">4</button>
                <button type="button" class="mag-l ml2" data-letter="H">H</button>
                <button type="button" class="mag-l ml3" data-letter="0">0</button>
                <button type="button" class="mag-l ml4" data-letter="M">M</button>
                <button type="button" class="mag-l ml5" data-letter="P">P</button>
                <button type="button" class="mag-l ml6" data-letter="4">4</button>
                <button type="button" class="mag-l ml7" data-letter="O">O</button>
                <button type="button" class="mag-l ml8" data-letter="A">A</button>
                <button type="button" class="mag-l ml9" data-letter="E">E</button>
                <button type="button" class="mag-l ml10" data-letter="G">G</button>
            </div>

            <p class="mag-strip">
                Spelled so far <span data-mag-word="">…</span>
            </p>

            <div class="mag-handle">
                <a class="nf-home" href="/">Fridge handle</a>
            </div>
        </div>

        <section class="mag-copy">
            <h1 class="nf-title">Someone moved the letters on the fridge.</h1>
            <p class="nf-message">
                They used to spell a page. Tap the letters to spell HOME
                and the fridge handle takes you there.
            </p>

            <div class="mag-actions">
                <button type="button" data-mag-clear="">Clear the word</button>
                <a href="/" class="btn btn-primary">메인 페이지</a>
            </div>

            <p class="play-status" data-status="" role="status" aria-live="polite">
                Tap the letters in order.
            </p>
        </section>
    </div>
</main>

<script>(function mountExperience(container) {
    const root=container.matches('[data-experience]')?container:container.querySelector('[data-experience]');
    if(!root)return ()=>{};
    const $=s=>root.querySelector(s), all=s=>Array.from(root.querySelectorAll(s));
    const cleanups=[];let disposed=false;
    const on=(el,event,fn,options)=>{if(!el)return;el.addEventListener(event,fn,options);cleanups.push(()=>el.removeEventListener(event,fn,options));};
    const say=text=>{const el=$('[data-status]');if(el)el.textContent=text;};
    const art=root.dataset.experience;
    const canvas=$('canvas');const ctx=canvas&&canvas.getContext('2d');
    const point=e=>{const r=canvas.getBoundingClientRect();return {x:(e.clientX-r.left)*canvas.width/r.width,y:(e.clientY-r.top)*canvas.height/r.height};};
    const reduced=()=>window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const here=location.protocol.indexOf('http')===0?location.pathname:'/the-page';

    if(art==='fin-magnets'){
        const word=[],shown=$('[data-mag-word]'),letters=all('[data-letter]'),fridge=$('[data-fridge]');
        const render=()=>{shown.textContent=word.length?word.join(''):'…';const done=word.join('').endsWith('HOME');root.classList.toggle('mag-done',done);return done;};
        letters.forEach(b=>on(b,'click',()=>{word.push(b.dataset.letter);if(word.length>8)word.shift();say(render()?'HOME. The fridge handle is the way there.':'Spelled '+word.join('')+'.');}));
        on($('[data-mag-clear]'),'click',()=>{word.length=0;render();say('Cleared. Tap the letters in order.');});
        on($('[data-mag-hint]'),'click',()=>say('H, O, M, E. In that order.'));
        on(fridge,'pointermove',e=>{if(reduced())return;letters.forEach(b=>{const r=b.getBoundingClientRect(),dx=e.clientX-(r.left+r.width/2),dy=e.clientY-(r.top+r.height/2),d=Math.hypot(dx,dy),pull=d<110&&d>0?(110-d)/110*6:0;b.style.setProperty('--dx',(pull?dx/d*pull:0).toFixed(1)+'px');b.style.setProperty('--dy',(pull?dy/d*pull:0).toFixed(1)+'px');});});
        on(fridge,'pointerleave',()=>letters.forEach(b=>{b.style.setProperty('--dx','0px');b.style.setProperty('--dy','0px');}));
    }
    return ()=>{disposed=true;cleanups.forEach(fn=>fn());};
})(document.querySelector('[data-experience]'));
if(window.parent!==window){const send=()=>window.parent.postMessage({type:'no404-preview-height',height:document.body.scrollHeight},'*');window.addEventListener('message',e=>{if(e.source===window.parent&&e.data?.type==='no404-preview-measure')send();});send();new ResizeObserver(send).observe(document.body);}</script>

